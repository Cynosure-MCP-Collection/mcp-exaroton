{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.cynosure/exaroton",
  "title": "exaroton Minecraft Server Manager",
  "description": "MCP server for managing exaroton Minecraft servers",
  "version": "1.0.2",
  "websiteUrl": "https://www.npmjs.com/package/@cynosure/exaroton",
  "icons": [
    {
      "src": "https://unpkg.com/@cynosure/exaroton@1.0.2/icon.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@cynosure/exaroton",
      "version": "1.0.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "EXAROTON_API_TOKEN",
          "description": "exaroton API token from https://exaroton.com/account",
          "isRequired": true,
          "isSecret": true,
          "placeholder": "Your exaroton API token"
        }
      ]
    }
  ]
}
