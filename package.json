{
  "name": "@cynosure-mcp/exaroton",
  "version": "1.0.3",
  "description": "MCP server for managing exaroton Minecraft servers",
  "mcpName": "io.github.cynosure/exaroton",
  "homepage": "https://www.npmjs.com/package/@cynosure-mcp/exaroton",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "exaroton",
    "minecraft"
  ],
  "type": "module",
  "bin": {
    "mcp-exaroton": "src/index.js"
  },
  "files": [
    "src/",
    "README.md",
    "icon.png",
    "server.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test",
    "version": "node scripts/sync-version.mjs && git add server.json",
    "release:check": "node scripts/sync-version.mjs --check"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "exaroton": "^2.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cynosure-MCP-Collection/mcp-exaroton.git"
  }
}
